{
  "name": "estospaces-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "postbuild": "node scripts/strip-static-home-runtime.mjs && node scripts/prepare-standalone.mjs",
    "lint": "biome lint --max-diagnostics=300 src/app src/components/blog src/components/landing/Home.jsx src/components/landing/LandingMotion.jsx src/components/landing/Navbar.jsx src/components/landing/Footer.jsx src/components/site src/config src/lib scripts blog.system.test.js launch-readiness.test.js server.api.test.js middleware.js next.config.mjs postcss.config.js tailwind.config.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css}\" \"scripts/*.{js,mjs}\" \"*.{js,mjs,json}\" \"docs/*.md\" \"PRODUCT.md\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css}\" \"scripts/*.{js,mjs}\" \"*.{js,mjs,json}\" \"docs/*.md\" \"PRODUCT.md\"",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run site:audit && npm run build",
    "test": "node --test server.api.test.js blog.system.test.js launch-readiness.test.js",
    "test:api": "node --test server.api.test.js",
    "test:blog": "node --test blog.system.test.js",
    "blogs:seed": "node scripts/seed-blogs.mjs",
    "blogs:update": "node scripts/update-blog-posts.mjs",
    "blogs:audit": "node scripts/audit-blog-seo.mjs",
    "blogs:validate": "node scripts/validate-blogs.mjs",
    "site:audit": "node scripts/audit-site-seo.mjs",
    "verify:launch": "node scripts/verify-launch.mjs",
    "perf:lighthouse": "node scripts/run-lighthouse.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "assets:og": "node scripts/generate-og-image.mjs",
    "start": "node .next/standalone/server.js"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@google-cloud/firestore": "^8.5.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.24.7",
    "google-auth-library": "^10.6.2",
    "lucide-react": "^0.554.0",
    "next": "^16.2.12",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.6",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.62.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "brace-expansion": "^5.0.9",
    "protobufjs": "^7.6.5",
    "sharp": "^0.35.3",
    "path-to-regexp": "^8.4.2",
    "qs": "^6.15.1"
  }
}
