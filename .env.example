# Email Service Configuration
# Choose one: 'resend' or 'sendgrid'
EMAIL_SERVICE=resend

# Resend Configuration (if using Resend)
# Verify the estospaces.com domain in Resend before using contact@estospaces.com in production.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL="Estospaces <contact@estospaces.com>"

# SendGrid Configuration (if using SendGrid)
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# SENDGRID_FROM_EMAIL=contact@estospaces.com

# Email Recipient
RESERVATION_EMAIL=contact@estospaces.com

# Reserve Your Spot live Google Sheet updates.
# Share the sheet with the service account email used below or with the Cloud Run
# runtime service account if GOOGLE_SHEETS_CLIENT_EMAIL/PRIVATE_KEY are omitted.
GOOGLE_SHEETS_SPREADSHEET_ID=1lcHZXqllQ6JT-pnnA6fN7cVqRt8xhZtU7TbBnsroUOA
GOOGLE_SHEETS_LEADS_RANGE=A:Q
GOOGLE_SHEETS_CLIENT_EMAIL=landing-sheets-service-account@your-gcp-project-id.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="replace_with_service_account_private_key_using_escaped_newlines"

# Landing public email/chat abuse throttling.
# Use Firestore in Cloud Run production; local development can use memory.
LANDING_RATE_LIMIT_STORE=firestore
LANDING_RATE_LIMIT_COLLECTION=landingApiRateLimits
LANDING_EMAIL_RATE_LIMIT_MAX=5
LANDING_EMAIL_RATE_LIMIT_WINDOW_MS=900000
LANDING_CHAT_START_RATE_LIMIT_MAX=30
LANDING_CHAT_START_RATE_LIMIT_WINDOW_MS=900000

# Allowed browser origins for cross-domain landing API calls.
# CORS_ALLOWED_ORIGINS is preferred. ALLOWED_ORIGINS is also accepted for Cloud Run compatibility.
CORS_ALLOWED_ORIGINS=https://app.estospaces.com,https://admin.estospaces.com,https://estospaces.com,https://www.estospaces.com

# Public app link used by the landing-page search and legal links.
NEXT_PUBLIC_APP_BASE_URL=https://app.estospaces.com

# Optional for cross-domain landing API calls. Leave empty when the Next.js
# frontend and API routes are served from the same origin.
NEXT_PUBLIC_LANDING_API_BASE_URL=

# Optional GA4 measurement ID. Required if you want external SEO tools to pass
# their Google Analytics detection check.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Blog data and asset storage.
# Firestore is used for production blog records. Local development falls back to
# src/data/generated-blog-posts.js when these values are not configured.
GCP_PROJECT_ID=your-gcp-project-id
GCP_CLIENT_EMAIL=blog-writer-service-account@your-gcp-project-id.iam.gserviceaccount.com
GCP_PRIVATE_KEY=
GCP_BUCKET_NAME=your-public-blog-assets-bucket
FIRESTORE_BLOG_COLLECTION=blogPosts
BLOG_USE_LOCAL_DATA=true
BLOG_TOPIC_SOURCE_PATH=docs/blog-posts-to-do
